# Northstar real-cluster handoff config.
# Copy this file to .env and edit the values for the target machine.

# Use kubernetes for real clusters. Use simulated for the built-in fake data.
NORTHSTAR_MODE=kubernetes

# Default selected kube context. Northstar still lists every context in the kubeconfig.
NORTHSTAR_CONTEXT=your-context-name

# Keep this true for first runs against real clusters. Set false only with scoped RBAC.
NORTHSTAR_READ_ONLY=true

# Local Node runs can use kubectl from PATH.
NORTHSTAR_KUBECTL=kubectl

# Local Node runs use this kubeconfig path directly.
NORTHSTAR_KUBECONFIG=/absolute/path/to/your/kubeconfig

# Docker Compose mounts this host kubeconfig into the container. This value is
# required by Docker Compose v1 and v2.
NORTHSTAR_KUBECONFIG_PATH=/absolute/path/to/your/kubeconfig

# Only needed when the kubeconfig points to local kind/minikube APIs published
# on 127.0.0.1 by the Docker host. Leave blank for remote clusters.
NORTHSTAR_KUBECONFIG_SERVER_HOST=

# Optional external Prometheus HTTP API for local Node runs.
NORTHSTAR_PROMETHEUS_URL=

# Optional Prometheus URL from inside Docker Compose. Leave blank to use bundled Prometheus.
# For a Prometheus running on the host machine, use http://host.docker.internal:9090.
NORTHSTAR_COMPOSE_PROMETHEUS_URL=

# Local ports.
PORT=5173
PROMETHEUS_PORT=9090

# Persistent application data. Docker Compose uses a named volume by default.
# For a bind mount, set NORTHSTAR_DATA_DIR on the host and adjust the compose volume.
